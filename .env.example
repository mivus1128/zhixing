# Compose 项目名决定 Docker 卷名称。修改后会使用一组新的空白运行数据。
COMPOSE_PROJECT_NAME=zhixing-v3

# 默认只允许从部署主机访问。远程使用请通过 SSH 隧道。
ZHIXING_WEB_HOST=127.0.0.1
ZHIXING_WEB_PORT=18765

# 与当前发布包验证过的 Selenium Chromium 镜像。
ZHIXING_BROWSER_IMAGE=selenium/standalone-chromium@sha256:e80834f17556d310d92f114c38df84a4c09bfa9564d428c770ea122346c0932c
ZHIXING_BROWSER_MEMORY=1g
ZHIXING_BROWSER_SHM_SIZE=512m

# 本地构建的镜像名，只是标签，不是远程凭据。
ZHIXING_API_IMAGE=zhixing-api:3.260817.00
ZHIXING_WEB_IMAGE=zhixing-web:3.260817.00
